{
  "name": "Order Tracking Chatbot (reads order file)",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "initialMessages": "Hi! 👋 Send me your order number (e.g. ORD-1001) to track your delivery.",
        "options": {
          "responseMode": "lastNode",
          "title": "Order Tracking"
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ],
      "webhookId": "c3d4e5f6-0000-4000-8000-000000000002"
    },
    {
      "parameters": {
        "jsCode": "// Pull an order ID like ORD-1001 (or \"ord 1001\" / \"1001\") out of the chat message\nconst text = String($input.first().json.chatInput || '');\nconst m = text.match(/(?:ord[-\\s]?)?(\\d{4,})/i);\nreturn [{ json: { chatInput: text, orderId: m ? 'ORD-' + m[1] : null } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Parse Order ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ !!$json.orderId }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Order ID Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        200
      ]
    },
    {
      "parameters": {
        "fileSelector": "/home/node/.n8n-files/orders.csv",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Read Orders File",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        720,
        100
      ]
    },
    {
      "parameters": {
        "operation": "csv",
        "options": {
          "headerRow": true
        }
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        940,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const orderId = $('Parse Order ID').first().json.orderId;\nconst rows = $input.all().map(i => i.json);\nconst row = rows.find(r => String(r.order_id).trim().toUpperCase() === orderId);\n\nif (!row) {\n  return [{ json: { output: \"Sorry, I couldn't find **\" + orderId + \"**. Please double-check the number and try again.\" } }];\n}\n\nconst lines = [\n  \"📦 **Order \" + row.order_id + \"**\" + (row.customer_name ? \" for \" + row.customer_name : \"\"),\n  \"**Status:** \" + row.status,\n  \"**Current location:** \" + row.current_location,\n  \"**Last updated:** \" + row.last_updated\n];\nif (row.eta) lines.push(\"**Estimated delivery:** \" + row.eta);\n\nreturn [{ json: { output: lines.join(\"\\n\\n\") } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "Find Order & Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { output: \"Hi! 👋 Please send me your order number (for example **ORD-1001**) and I'll tell you where your order is.\" } }];"
      },
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Ask For Order ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        320
      ]
    }
  ],
  "connections": {
    "Chat Trigger": {
      "main": [
        [
          {
            "node": "Parse Order ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Order ID": {
      "main": [
        [
          {
            "node": "Order ID Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Order ID Found?": {
      "main": [
        [
          {
            "node": "Read Orders File",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ask For Order ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Orders File": {
      "main": [
        [
          {
            "node": "Parse CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse CSV": {
      "main": [
        [
          {
            "node": "Find Order & Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}